{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*credentials*": "ask",
      "*secret*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "~/.ssh/*": "ask",
      "~/.gnupg/*": "ask",
      "~/.aws/*": "ask",
      "~/.config/gcloud/*": "ask",
      "~/Library/Keychains/*": "ask",
      "~/Library/Application Support/*credentials*": "ask",
      "*.env.example": "allow"
    },
    "external_directory": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run check*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "pnpm lint*": "allow",
      "pnpm check*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm build*": "allow",
      "yarn test*": "allow",
      "yarn lint*": "allow",
      "yarn build*": "allow",
      "bun test*": "allow",
      "bun run test*": "allow",
      "bun run lint*": "allow",
      "bun run check*": "allow",
      "bun run build*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "go test*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt --check*": "allow",
      "make test*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "dd *": "ask",
      "diskutil *": "ask",
      "launchctl *": "ask",
      "defaults write *": "ask",
      "security *": "ask",
      "xattr *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git branch -D *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git push *": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "yarn publish*": "ask",
      "brew install*": "ask",
      "brew uninstall*": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "osascript *": "ask",
      "rm -rf /": "deny"
    }
  }
}

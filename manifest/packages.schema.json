{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weixijia/awesome-pi-setup/blob/main/manifest/packages.schema.json",
  "type": "object",
  "required": ["snapshotDate", "pi", "packages", "removedPackages"],
  "properties": {
    "$schema": { "type": "string" },
    "snapshotDate": { "type": "string", "format": "date" },
    "pi": {
      "type": "object",
      "required": ["name", "minimumVersion", "repository"],
      "properties": {
        "name": { "type": "string" },
        "minimumVersion": { "type": "string" },
        "repository": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["spec", "repository", "integrity", "purpose"],
        "properties": {
          "spec": { "type": "string", "pattern": "^npm:" },
          "repository": { "type": "string", "format": "uri" },
          "integrity": { "type": "string", "pattern": "^sha512-" },
          "purpose": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "removedPackages": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
